{
  "name": "pagila-api-data-tests",
  "version": "1.0.0",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "seed": "ts-node scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ts": "playwright test",
    "test:py": "pytest"
  },
  "keywords": [
    "testing",
    "api-testing",
    "playwright",
    "pytest",
    "json-schema",
    "postgresql",
    "pagila"
