{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer",
  "description": "Response shape of GET /api/customer/:id",
  "type": "object",
  "required": ["customer_id", "first_name", "last_name", "email"],
  "additionalProperties": false,
  "properties": {
    "customer_id": {
      "type": "integer",
      "minimum": 1
    },
    "first_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 45
    },
    "last_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 45
    },
    "email": {
      "type": ["string", "null"],
      "format": "email",
      "maxLength": 50
    }
  }
}
